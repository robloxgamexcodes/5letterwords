---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinderBlock from './FinderBlock.astro';
import BrowseLists from './BrowseLists.astro';
import Hero from './Hero.astro';
import InsightBlocks from './InsightBlocks.astro';
import DailyStrip from './game/DailyStrip';
import RelatedLinks from './RelatedLinks.astro';
import { countFor, getWords } from '../lib/words';
import { finderFacts } from '../lib/stats';
import { finderArticle, finderFaq, finderIntro, finderMeta } from '../lib/copy';
import { BUILD_DATE, abs, lengthPath } from '../lib/site';

interface Props { len: number; }
const { len } = Astro.props;
const count = countFor(len);
const meta = finderMeta(len);
const article = finderArticle(len);
const faq = finderFaq(len, count);
const url = abs(lengthPath(len));
const facts = finderFacts(getWords(len), len);
---
<BaseLayout title={meta.title} description={meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebApplication', name: `${len} Letter Word Finder`, url, description: meta.description, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any (web browser)', browserRequirements: 'Requires JavaScript', inLanguage: 'en', dateModified: BUILD_DATE, isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': `${abs('/')}#organization` } })} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />
  </Fragment>
  <div class="container page">
    <Hero len={len} count={count} intro={finderIntro(len, count)} />
    <FinderBlock len={len} statusLabel="Everyday words" pageSize={80} sample />
    <DailyStrip client:only="react" />

    <div class="blocks">
      <InsightBlocks len={len} />
      <section class="card block" aria-label={article.h2}>
        <h2>{article.h2}</h2>
        <p>{article.intro}</p>
        <p>{facts}</p>
      </section>
      <section class="card block" aria-label={article.featuresH}>
        <h2>{article.featuresH}</h2>
        <ul>{article.features.map((f) => <li>{f}</li>)}</ul>
      </section>
      <section class="card block" aria-label={article.stepsH}>
        <h2>{article.stepsH}</h2>
        <ol>{article.steps.map((f) => <li>{f}</li>)}</ol>
      </section>
      <section class="card block" aria-label={article.tipsH}>
        <h2>{article.tipsH}</h2>
        <ul>{article.tips.map((f) => <li>{f}</li>)}</ul>
      </section>
      <section class="card block" aria-label={article.gamesH}>
        <h2>{article.gamesH}</h2>
        <ul>{article.games.map(([name, href, text]) => <li><a href={href}>{name}</a> — {text}</li>)}</ul>
      </section>

      <RelatedLinks len={len} />
      <BrowseLists len={len} />

      <section class="faq card block" aria-labelledby="faq-title">
        <h2 id="faq-title">Frequently asked questions</h2>
        {faq.map(({ q, a }) => (
          <details><summary>{q}</summary><p>{a}</p></details>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>
