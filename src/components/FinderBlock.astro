---
import WordFinder from './finder/WordFinder';
import { GAME_LINKS, LENGTHS, SOLVER_LINKS, TOOL_CARDS, lengthPath } from '../lib/site';
import type { Base } from '../lib/filter';
import { dictionariesFor, getData, matchesBaseServer, orderWords } from '../lib/words';

interface Props {
  len: number;
  base?: Base;
  dictionary?: string;
  /** Heading shown above the list: "Common words" on finder pages, "All words" on list pages. */
  statusLabel: string;
  /** Number of words rendered in the server HTML (and shown before "Show more"). */
  pageSize: number;
  /** True when the label's count is the page size (sample lists) rather than the full pool. */
  sample?: boolean;
  activeLength?: number | null;
}
const { len, base = null, dictionary = 'all', statusLabel, pageSize, sample = false, activeLength = len } = Astro.props;
const data = getData(len);
const set = dictionary !== 'all' ? data.sets[dictionary] : null;
const pool = orderWords(len, data.words.filter((w, i) => (!set || set.has(i)) && matchesBaseServer(w, base)));
const dictionaries = dictionariesFor(len);
const initialWords = pool.slice(0, pageSize);
const defaultDictionary = dictionaries.includes(dictionary) ? dictionary : 'all';

// A real "letter run" example for the help text, computed from the data so it is always correct.
const EXAMPLE_PATTERNS: Record<number, string> = { 3: 'c_t', 4: 'b_ll', 5: 's_are', 6: 's_ared', 7: 's_aring' };
const pattern = EXAMPLE_PATTERNS[len];
const re = new RegExp(`^${pattern.replace('_', '.')}$`);
const example = { pattern, hits: orderWords(len, data.words.filter((w) => re.test(w))).slice(0, 3) };
---
<div class="finder-block">
  <div class="length-picker" role="group" aria-label="Word length">
    <span class="length-label">Length</span>
    {LENGTHS.map((n) => (
      <a href={lengthPath(n)} class={n === activeLength ? 'on' : ''} aria-current={n === activeLength ? 'true' : undefined} aria-label={`${n} letter words`}>{n}</a>
    ))}
  </div>
  <div class="finder-layout">
    <WordFinder
      client:load
      len={len}
      base={base}
      initialWords={initialWords}
      initialCount={sample ? initialWords.length : pool.length}
      statusLabel={statusLabel}
      showMoreInitially={!sample}
      pageSize={pageSize}
      dictionaries={dictionaries}
      defaultDictionary={defaultDictionary}
      example={example}
    />
    <aside class="finder-aside" aria-label="More word tools">
      <ul class="tool-cards">
        {TOOL_CARDS.map((t) => (
          <li><a href={t.href}><strong>{t.label}</strong><span>{t.hint}</span></a></li>
        ))}
      </ul>
      <h2>Solvers</h2>
      <ul class="game-links">
        {SOLVER_LINKS.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
      </ul>
      <h2>Games</h2>
      <ul class="game-links">
        {GAME_LINKS.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
      </ul>
    </aside>
  </div>
</div>
